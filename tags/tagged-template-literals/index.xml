    <item>
      <title>Tagged Template Literals について怪しかったので調べた</title>
      <link>https://tro3373.github.io/posts/2023/2023-12-06-about-tagged-template-literals/</link>
      <pubDate>Wed, 06 Dec 2023 05:59:56 +0900</pubDate>
