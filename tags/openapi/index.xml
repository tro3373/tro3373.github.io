&lt;/a&gt;

&lt;ul&gt;
&lt;li&gt;swagger&lt;/li&gt;
&lt;li&gt;ecr&lt;/li&gt;
&lt;li&gt;lambda&lt;/li&gt;
&lt;li&gt;apigateway&lt;/li&gt;
&lt;li&gt;codebuild&lt;/li&gt;
&lt;li&gt;aws_lambda_alias
&lt;ul&gt;
&lt;li&gt;lambda version に対するエイリアス&lt;/li&gt;
&lt;li&gt;これに対するIgnore設定の記載など&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://qiita.com/sakuchi/items/7c5bd06a863c1f87e9d3&#34;
  
   target=&#34;_blank&#34; rel=&#34;noopener&#34; &gt;
